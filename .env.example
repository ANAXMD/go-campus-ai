# Copy to .env and change the values. .env is git-ignored.
#
# Use hex/alphanumeric only for POSTGRES_PASSWORD: it is placed inside a URL.
#   openssl rand -hex 16   -> POSTGRES_PASSWORD
#   openssl rand -hex 32   -> JWT_SECRET (the API refuses to start under 32 characters)
POSTGRES_PASSWORD=dev-only-change-me
JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789

# Origins allowed to call the API from a browser (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Who can change the directory. Everyone else who signs in is a read-only viewer.
# This list is the source of truth: it is applied at every start, so removing an
# address here demotes that account the next time the API restarts. Register with
# one of these addresses to get an administrator account.
ADMIN_EMAILS=admin@example.com

# Set to false for invite-only: then only the addresses in ADMIN_EMAILS can create
# an account (they have to exist for anyone to be able to sign up at all).
ALLOW_REGISTRATION=true
