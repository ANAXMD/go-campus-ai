# Copy to .env and change the values. .env is git-ignored.
#
# Use hex/alphanumeric only for POSTGRES_PASSWORD: it is placed inside a URL.
#   openssl rand -hex 16   -> POSTGRES_PASSWORD
#   openssl rand -hex 32   -> JWT_SECRET (the API refuses to start under 32 characters)
POSTGRES_PASSWORD=dev-only-change-me
JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789

# Origins allowed to call the API from a browser (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000
